{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planalign.fidelity.internal/schemas/backtest-scorecard/1.0.0.json",
  "title": "Backtest Scorecard",
  "description": "Predicted-vs-actual scores for a parameter pack fitted on early census snapshots and evaluated against held-out later years. Generated from planalign_backtest.models.Scorecard; do not hand-edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_fingerprint",
    "split",
    "seeds",
    "seed_runs",
    "thresholds",
    "overridden_thresholds",
    "comparisons",
    "verdict",
    "verdict_summary",
    "provenance",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Bumped on incompatible structure change (FR-024)."
    },
    "scorecard_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the canonical JSON of every other field. Referenced from run_metadata."
    },
    "split": { "$ref": "#/$defs/split" },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "integer" }
    },
    "seed_runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/seedRun" }
    },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "overridden_thresholds": {
      "type": "array",
      "items": { "enum": ["headcount", "compensation", "flows", "plan"] },
      "description": "Threshold families the analyst moved from their defaults."
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/comparison" },
      "description": "Ordered by metric identifier, then period. Every registry metric appears for every held-out year and for 'cumulative'."
    },
    "verdict": {
      "enum": ["pass", "warn", "fail"],
      "description": "Worst status among observable comparisons. Derived, never assigned."
    },
    "verdict_summary": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "period": {
      "oneOf": [
        { "type": "integer", "minimum": 1900, "maximum": 2200 },
        { "const": "cumulative" }
      ]
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warn", "fail"],
      "properties": {
        "warn": { "type": "number", "exclusiveMinimum": 0 },
        "fail": { "type": "number", "exclusiveMinimum": 0 }
      },
      "description": "Percentage-error bounds as decimal fractions. warn < fail."
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headcount", "compensation", "flows", "plan"],
      "properties": {
        "headcount": { "$ref": "#/$defs/threshold" },
        "compensation": { "$ref": "#/$defs/threshold" },
        "flows": { "$ref": "#/$defs/threshold" },
        "plan": { "$ref": "#/$defs/threshold" }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit_years", "holdout_years", "boundary_year", "all_years"],
      "properties": {
        "fit_years": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "integer" },
          "description": "Years the parameters were fitted on. At least 2."
        },
        "holdout_years": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "integer" }
        },
        "boundary_year": {
          "type": "integer",
          "description": "max(fit_years); the census the simulation starts from."
        },
        "all_years": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "integer" }
        }
      }
    },
    "seedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "database", "config_fingerprint", "years_simulated"],
      "properties": {
        "seed": { "type": "integer" },
        "database": {
          "type": "string",
          "description": "Path to the isolated per-seed database. May no longer exist unless --keep-databases was passed."
        },
        "config_fingerprint": {
          "type": "string",
          "description": "From run_metadata. Differs per seed by construction."
        },
        "years_simulated": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        }
      }
    },
    "seedSpread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_count",
        "minimum",
        "maximum",
        "values",
        "actual_within_spread",
        "distance_outside"
      ],
      "properties": {
        "seed_count": { "type": "integer", "minimum": 2 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number" },
          "description": "One value per seed, in seed order."
        },
        "actual_within_spread": { "type": "boolean" },
        "distance_outside": {
          "type": ["number", "null"],
          "description": "Signed distance beyond the nearer bound; null when the actual falls inside."
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "period",
        "family",
        "observable",
        "unobservable_reason",
        "predicted",
        "actual",
        "absolute_error",
        "percent_error",
        "threshold",
        "status",
        "spread"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "description": "Stable identifier, e.g. headcount.total, headcount.by_level.3, plan.participation_rate."
        },
        "period": { "$ref": "#/$defs/period" },
        "family": { "enum": ["headcount", "compensation", "flows", "plan"] },
        "observable": { "type": "boolean" },
        "unobservable_reason": {
          "type": ["string", "null"],
          "description": "Required when observable is false; null otherwise."
        },
        "predicted": {
          "type": ["number", "null"],
          "description": "Per-metric lower median across seeds. Null iff not observable."
        },
        "actual": { "type": ["number", "null"] },
        "absolute_error": {
          "type": ["number", "null"],
          "description": "predicted - actual. Signed."
        },
        "percent_error": {
          "type": ["number", "null"],
          "description": "absolute_error / actual. Null when actual is zero (FR-018)."
        },
        "threshold": {
          "oneOf": [{ "$ref": "#/$defs/threshold" }, { "type": "null" }]
        },
        "status": {
          "enum": ["pass", "warn", "fail", "not_observable", "undefined"]
        },
        "spread": {
          "oneOf": [{ "$ref": "#/$defs/seedSpread" }, { "type": "null" }],
          "description": "Null for single-seed runs (FR-022)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "observable": { "const": false } } },
          "then": {
            "properties": {
              "status": { "const": "not_observable" },
              "predicted": { "type": "null" },
              "actual": { "type": "null" },
              "absolute_error": { "type": "null" },
              "percent_error": { "type": "null" },
              "unobservable_reason": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observable": { "const": true },
              "actual": { "const": 0 }
            },
            "required": ["actual"]
          },
          "then": {
            "properties": {
              "percent_error": { "type": "null" },
              "status": { "const": "undefined" }
            }
          }
        }
      ]
    },
    "snapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "filename", "sha256", "row_count", "role"],
      "properties": {
        "year": { "type": "integer" },
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "row_count": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["fit", "holdout"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshots",
        "source_digest",
        "pack_id",
        "pack_fingerprint",
        "promotion_basis",
        "level_basis",
        "compensation_basis",
        "backtest_date",
        "tool_version"
      ],
      "properties": {
        "snapshots": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/snapshotRef" }
        },
        "source_digest": {
          "type": "string",
          "description": "Digest over the FITTED snapshots only. Matches the pack manifest."
        },
        "pack_id": { "type": "string" },
        "pack_fingerprint": {
          "type": "string",
          "description": "Pack fingerprint at backtest time. A later mismatch marks the scorecard stale (FR-026)."
        },
        "promotion_basis": {
          "type": "string",
          "description": "Whether the promotion hazard was fitted or a retained default (#511)."
        },
        "level_basis": {
          "enum": ["census_level_id", "compensation_band"],
          "description": "Which basis produced by-level headcount on both sides."
        },
        "compensation_basis": {
          "type": "string",
          "description": "Fixed to the annualized rate for active employees at year end."
        },
        "backtest_date": { "type": "string", "format": "date-time" },
        "tool_version": { "type": "string" }
      }
    }
  }
}
