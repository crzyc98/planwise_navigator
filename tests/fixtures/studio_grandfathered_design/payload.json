{
  "plan_design_assignment": {
    "default_plan_design_id": "existing_employees",
    "rules": [
      {
        "type": "hire_date_cutoff",
        "cutoff": "2015-01-01",
        "plan_design_id": "new_hires"
      }
    ]
  },
  "plan_design_parameters": {
    "existing_employees": {
      "match": {
        "family": "deferral_based",
        "match_template": "tiered",
        "cap_percent": 0.04,
        "tiers": [
          {
            "employee_min": 0,
            "employee_max": 0.03,
            "match_rate": 1
          },
          {
            "employee_min": 0.03,
            "employee_max": 0.05,
